# ==============================================================================
# FixMyCity Municipal Grievance System - Environment Configuration
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# JWT Authentication Secret
# CRITICAL: In production, the server will throw an error on startup if this is not set.
# In development, an ephemeral random secret is generated per-process if unset.
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Aadhaar HMAC Pepper Key
# CRITICAL: Used to compute deterministic HMAC-SHA256 hashes of Aadhaar numbers so
# raw digits are never stored or exposed. In production, the server throws if unset.
AADHAAR_PEPPER=replace_with_a_secure_pepper_secret_for_aadhaar_hmac

# Python 3 Executable
# Used by analytics endpoints to generate Matplotlib charts via stdin.
# Defaults to 'python3' (or 'python' on Windows).
PYTHON_BIN=python

# Nodemailer / SMTP Configuration
# If provided, real emails will be dispatched (e.g., Gmail, SendGrid, or custom SMTP).
# If omitted, Ethereal mock test account is used or codes are logged to console.
SMTP_USER=
SMTP_PASS=

# Offline / Demo OTP Debug Flag
# Set to 'true' to echo the 6-digit OTP code in API responses for offline testing.
# NEVER ENABLED IN PRODUCTION (enforced in code). Defaults to false.
OTP_DEBUG=false

# MongoDB Connection URI (Optional)
# If using MongoDB instead of the default local SQLite database.
MONGO_URI=mongodb://localhost:27017/municipal_grievance
